{
  "name": "evidenceq",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "turbo run build",
    "vercel-build": "pnpm --filter @evidenceq/database db:generate && pnpm --filter @evidenceq/web build",
    "dev": "turbo run dev --parallel --filter=@evidenceq/web --filter=@evidenceq/api --filter=@evidenceq/worker",
    "dev:web": "pnpm --filter @evidenceq/web dev",
    "dev:api": "pnpm --filter @evidenceq/api dev",
    "dev:worker": "pnpm --filter @evidenceq/worker dev",
    "db:migrate": "pnpm --filter @evidenceq/database db:migrate",
    "db:generate": "pnpm --filter @evidenceq/database db:generate",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test apps/api/src/**/*.test.ts apps/worker/src/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.2.0",
    "eslint-config-prettier": "^10.1.5",
    "next": "^15.2.0",
    "prettier": "^3.6.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.20.3",
    "turbo": "^2.6.3",
    "typescript": "^5.9.2"
  }
}
